{
  "name": "@rwillians/exto",
  "description": "Type-safe SQL for Bun: import .sql files, typed from your migrations.",
  "version": "0.1.2",
  "author": "Rafael Willians <me@rwillians.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rwillians/exto.git"
  },
  "keywords": [
    "bun",
    "migrations",
    "postgres",
    "sql",
    "sqlite",
    "type-safe",
    "type-safety",
    "typescript"
  ],
  "type": "module",
  "module": "dist/esm/index.js",
  "main": "dist/cjs/index.js",
  "files": [
    "dist/",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./bun-sqlite": {
      "types": "./dist/types/bun-sqlite.d.ts",
      "import": "./dist/esm/bun-sqlite.js",
      "require": "./dist/cjs/bun-sqlite.js",
      "default": "./dist/cjs/bun-sqlite.js"
    }
  },
  "scripts": {
    "build": "bun run build:cjs && bun run build:esm",
    "build:cjs": "bun run --bun tsc --project tsconfig-cjs.json",
    "build:esm": "bun run --bun tsc --project tsconfig-esm.json",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.1.0-dev.20261114.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": "^7.1.0-0"
  }
}
