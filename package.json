{
  "name": "@rwillians/exto",
  "description": "A teeny tiny, type-safe query builder for Bun, with adapters for SQLite and PostgreSQL.",
  "version": "0.5.0",
  "author": "Rafael Willians <me@rwillians.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rwillians/exto.git"
  },
  "keywords": [
    "bun",
    "migrations",
    "postgres",
    "sql",
    "sqlite",
    "type-safe",
    "type-safety",
    "typescript"
  ],
  "type": "module",
  "module": "dist/esm/index.js",
  "main": "dist/cjs/index.js",
  "files": [
    "dist/",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./bun-postgres": {
      "types": "./dist/types/bun-postgres.d.ts",
      "import": "./dist/esm/bun-postgres.js",
      "require": "./dist/cjs/bun-postgres.js",
      "default": "./dist/cjs/bun-postgres.js"
    },
    "./bun-sqlite": {
      "types": "./dist/types/bun-sqlite.d.ts",
      "import": "./dist/esm/bun-sqlite.js",
      "require": "./dist/cjs/bun-sqlite.js",
      "default": "./dist/cjs/bun-sqlite.js"
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun run build:cjs && bun run build:esm",
    "build:cjs": "bun run --bun tsc --project tsconfig-cjs.json",
    "build:esm": "bun run --bun tsc --project tsconfig-esm.json",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
